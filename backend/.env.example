# Backend (Express + Mongoose) environment variables.
# Copy this file to `.env` and fill in the real values.
#
# PORT must be 1-65535. A PORT of 0 makes Node bind a random ephemeral port,
# so it is rejected and falls back to 5000 with a warning. Most hosts inject
# PORT themselves (Render sets it automatically) — leave this as-is unless you
# need a specific local port.
PORT=5000

# MongoDB connection string.
# - Local development: a MongoDB running on this machine, e.g.
#     mongodb://127.0.0.1:27017/cloudfilestorage
# - Production: paste your real cluster connection string (e.g. MongoDB Atlas),
#   e.g. mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cloudfilestorage?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string_here

# Signs session tokens. Use a long random string (32+ characters).
JWT_SECRET=replace-with-a-long-random-hex-string

# Cloudinary credentials (Settings -> API Keys in the Cloudinary dashboard).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Frontend origin(s) allowed by CORS. Replace this with your deployed
# frontend URL before going live, e.g. https://your-app.vercel.app
# Multiple origins may be given as a comma-separated list:
#   CLIENT_URL=https://staging.example.com,https://example.com
# In production the localhost dev origins are NOT allowed automatically.
CLIENT_URL=http://localhost:5173
