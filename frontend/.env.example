# Frontend (Vite) environment variables.
# Copy this file to `.env` for local development.
#
# Local development (backend running on this machine):
VITE_API_URL=http://localhost:5000/api
#
# Production (after the backend is deployed on Render) — set this in the
# Vercel project's Environment Variables instead of editing this file:
# VITE_API_URL=https://your-backend.onrender.com/api
#
# VITE_ prefixed variables are baked in at build time, so after changing
# them you must rebuild/redeploy the frontend for the change to take effect.
